<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Date Selection Card (Tapping opens Calendar Picker) -->
        <LinearLayout
            android:id="@+id/card_date_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Main Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/background_profile_item_icon"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_calendar_today"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_day_date_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thursday, 27 Aug"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_relative_day_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Today's Menu"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_pick_date"
                    style="@style/Widget.VTOP.CompactButton.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingStart="14dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="0dp"
                    android:text="Calendar"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_calendar_today"
                    app:iconSize="14dp" />
            </LinearLayout>

            <!-- Dynamic Actions Row (expands with ample room on date change) -->
            <LinearLayout
                android:id="@+id/layout_date_actions_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_date_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Custom date selected"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_today_quick"
                    style="@style/Widget.VTOP.CompactButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingStart="14dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="0dp"
                    android:text="Back to Today"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_sync"
                    app:iconSize="13dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Meal Type Tabs (Breakfast, Lunch, Snacks, Dinner) with Equal Dimensions -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_meals"
            style="@style/Widget.VTOP.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:contentDescription="Meal Times"
            app:tabGravity="fill"
            app:tabMode="fixed" />

        <!-- Main Meal Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Header: Icon, Meal Title, Timing, Status Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_meal_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/background_profile_item_icon"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_breakfast"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_meal_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_breakfast"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_meal_timing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/breakfast_timings"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_meal_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_pill_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="MENU"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Dynamic Structured Dishes List Container -->
            <LinearLayout
                android:id="@+id/layout_meal_dishes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Fallback Dishes Text (shown if dynamic container is empty) -->
            <TextView
                android:id="@+id/text_meal_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="Loading menu items..."
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Special Meal Notes (e.g. Ghee/Podi for Lunch, Hot Milk/Salad for Dinner) -->
            <LinearLayout
                android:id="@+id/layout_meal_special_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/background_dish_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/text_meal_special_notes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
