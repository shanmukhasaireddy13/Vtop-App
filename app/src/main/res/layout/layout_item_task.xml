<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_task"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Completion Checkbox -->
        <CheckBox
            android:id="@+id/checkbox_complete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:button="@null"
            android:background="?android:attr/listChoiceIndicatorMultiple"
            android:gravity="center"
            android:layout_marginEnd="12dp" />

        <!-- Vertical bar color indicator -->
        <View
            android:id="@+id/view_type_indicator"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/colorPrimary" />

        <!-- Task Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00 - 08:00"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Wake Up &amp; Morning Routine"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_task_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">
                <TextView
                    android:id="@+id/text_task_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="COLLEGE CLASS"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Alarm/Notification Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_alarm_toggle"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_notifications"
            app:iconSize="20dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:contentDescription="Toggle Alarm" />

        <!-- Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_task"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_close"
            app:iconSize="20dp"
            app:iconTint="?attr/colorError"
            android:contentDescription="Delete Task" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
